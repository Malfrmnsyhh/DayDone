# ==========================================================
# DayDone API — Environment Variables
# ==========================================================
# Salin file ini menjadi .env dan isi nilainya.
# Jangan pernah commit file .env ke Git.
# ==========================================================

# ----------------------------------------------------------
# M0: Server
# ----------------------------------------------------------
NODE_ENV=development
PORT=3000

# ----------------------------------------------------------
# M2: Database (Supabase PostgreSQL)
# ----------------------------------------------------------
# Gunakan connection string Session pooler dari dashboard Supabase.
# Karakter khusus di password harus di-URL-encode.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# URL publik API, untuk membentuk signed URL lampiran.
PUBLIC_API_URL=http://localhost:3000

# Daftar origin CORS, dipisah koma.
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------
# M4: Google OAuth & Sesi (Wajib di M4)
# ----------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=GOCSPX-your-google-web-client-secret
# openssl rand -base64 48 (min. 32 karakter)
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# openssl rand -base64 32 (tepat 32 byte base64)
TOKEN_ENCRYPTION_KEY=your-32-byte-base64-encryption-key=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ----------------------------------------------------------
# M5: Storage & Drive (Menyusul di M5)
# ----------------------------------------------------------
# ATTACHMENT_URL_SECRET=       # hasil: openssl rand -base64 48

# ----------------------------------------------------------
# Observability (opsional)
# ----------------------------------------------------------
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
