# ==========================================================
# DayDone API — Environment Variables
# ==========================================================
# Salin file ini menjadi .env dan isi nilainya.
# Jangan pernah commit file .env ke Git.
# ==========================================================

# ----------------------------------------------------------
# M0: Server
# ----------------------------------------------------------
NODE_ENV=development
PORT=3000

# ----------------------------------------------------------
# M2: Database (Supabase PostgreSQL)
# ----------------------------------------------------------
# Gunakan connection string Session pooler dari dashboard Supabase.
# Karakter khusus di password harus di-URL-encode.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# URL publik API, untuk membentuk signed URL lampiran.
PUBLIC_API_URL=http://localhost:3000

# Daftar origin CORS, dipisah koma.
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------
# M4: Google OAuth & Sessions
# ----------------------------------------------------------
# JWT_ACCESS_SECRET=           # hasil: openssl rand -base64 48
# JWT_ACCESS_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30
# TOKEN_ENCRYPTION_KEY=        # hasil: openssl rand -base64 32 (harus 32 byte setelah decode)
# GOOGLE_WEB_CLIENT_ID=        # xxxx.apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_SECRET=    # GOCSPX-...
# COOKIE_SAMESITE=lax          # gunakan "none" bila web dan API beda domain induk

# ----------------------------------------------------------
# M3: Development Auth (sementara, sebelum M4 selesai)
# ----------------------------------------------------------
# DEV_AUTH_ENABLED=true        # hanya development; app menolak start bila true di production

# ----------------------------------------------------------
# M5: Storage & Drive
# ----------------------------------------------------------
# ATTACHMENT_URL_SECRET=       # hasil: openssl rand -base64 48

# ----------------------------------------------------------
# Observability (opsional)
# ----------------------------------------------------------
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

