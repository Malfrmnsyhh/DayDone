# ==========================================================
# DayDone API — Test Environment Variables (Local DB)
# ==========================================================
# Variabel untuk pengujian e2e dengan PostgreSQL lokal Docker (port 5433).
# JANGAN PERNAH mengarahkan file ini ke database Supabase / produksi!
# ==========================================================

NODE_ENV=test
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/daydone_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/daydone_test

CORS_ORIGINS=http://localhost:5173
DEV_AUTH_ENABLED=true

