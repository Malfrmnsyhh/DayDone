# ==========================================================
# DayDone API — Test Environment Variables (Local DB / CI)
# ==========================================================
# PERHATIAN: Seluruh nilai di file ini KHUSUS UNTUK TESTING (E2E & CI).
# Nilai-nilai ini adalah DUMMY yang lolos validasi envSchema Zod.
# Nilai ini BUKAN RAHASIA, dan JANGAN PERNAH dipakai di development atau produksi!
# JANGAN PERNAH mengarahkan file ini ke database Supabase / remote / produksi!
# ==========================================================

NODE_ENV=test
PORT=3001
PUBLIC_API_URL=http://localhost:3001

# Kredensial database lokal (sama persis dengan docker-compose.yml dan ci.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/daydone_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/daydone_test

CORS_ORIGINS=http://localhost:5173

# Dummy Google OAuth credentials untuk test
GOOGLE_WEB_CLIENT_ID=test-google-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=test-google-web-client-secret

# Dummy JWT Secret (min. 32 karakter)
JWT_ACCESS_SECRET=test-jwt-access-secret-min-32-chars-long!
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Dummy AES-256-GCM encryption key (tepat 32-byte base64)
TOKEN_ENCRYPTION_KEY=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=

COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# M5: Dummy Secret URL Lampiran (min. 32 karakter)
ATTACHMENT_URL_SECRET=test-attachment-url-secret-min-32-chars-long!

# M6: Server Hardening & Swagger
TRUST_PROXY=0
SWAGGER_ENABLED=true
